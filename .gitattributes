* text=auto

# Unified diffs must preserve whitespace in their context lines.
Tools/Patches/*.patch text eol=lf -whitespace
*.ps1 text eol=crlf
*.sh text eol=lf
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.spp filter=lfs diff=lfs merge=lfs -text
*.ssa filter=lfs diff=lfs merge=lfs -text
*.sbsar filter=lfs diff=lfs merge=lfs -text
*.sbs text
*.psd filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# Preserve the exact text bytes of the frozen architectural review package.
Assets/Concepts/OpeningLobby/ArchitectureRework01/*.svg text eol=lf
Assets/Concepts/OpeningLobby/ArchitectureRework01/*.json text eol=lf
Assets/Concepts/OpeningLobby/ArchitectureRework01/*.md text eol=lf
Assets/Concepts/OpeningLobby/ArchitectureRework01/*.mjs text eol=lf
Assets/Concepts/OpeningLobby/ArchitectureRework01/*.sha256 text eol=lf

# Accepted lobby manifests identify exact native source/reference bytes.
# Disable newline conversion without changing extension-specific LFS filters.
Assets/Concepts/OpeningLobby/** -text
Assets/Concepts/PlayerCharacter01/** -text
Assets/Source/OpeningLobby/** -text
Assets/Source/PlayerCharacter01/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Docs/Approvals/** -text
Docs/OpeningLobby* -text
Docs/Tasks/OpeningLobby* -text
Scripts/OpeningLobby/** -text

# Preserve exact report/script fingerprints registered for the shoulder intake.
Docs/PlayerCharacter01ShoulderIntake01.md -text
Scripts/PlayerCharacter01/shoulder_intake01.py -text

# Preserve exact report/script fingerprints registered for the body intake.
