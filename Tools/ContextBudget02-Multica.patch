+func TestContextBudgetSemanticIdentityRotation(t *testing.T) {
+	root := t.TempDir()
+	logical := map[string]any{"multica-plugins": map[string]any{"connection": "installation", "tools": []any{"inspect:schema1"}}}
+	makeConfig := func(run, token, port string) (map[string]any, string) {
+		home := filepath.Join(root, "Saved", run, "codex-home")
+		return map[string]any{
+			"model": "gpt-6-astra", "model_reasoning_effort": "max", "tool_output_token_limit": 2048,
+			"args":                     []any{"--api-key", token, "--mode=retained"},
+			"skills":                   map[string]any{"config": []any{map[string]any{"path": filepath.Join(home, "skills", "example"), "enabled": false}}},
+			"shell_environment_policy": map[string]any{"set": map[string]any{"MULTICA_TASK_ID": run, "MULTICA_TOKEN": token, "TMPDIR": filepath.Join(filepath.Dir(home), "tmp"), "BEHAVIOR": "preserved"}},
+			"mcp_servers": map[string]any{
+				"unused":          map[string]any{"enabled": false, "url": "http://127.0.0.1:" + port + "/" + token, "env": map[string]any{"RANDOM": run}},
+				"multica-plugins": map[string]any{"enabled": true, "url": "http://127.0.0.1:" + port + "/" + token, "headers": map[string]any{"Authorization": token, "X-Protocol-Version": "2"}},
+			},
+		}, home
+	}
+	one, homeOne := makeConfig("run-one", "token-one", "10001")
+	two, homeTwo := makeConfig("run-two", "token-two", "20002")
+	configOne, err := contextBudgetSemanticConfig(one, logical, root, homeOne)
+	if err != nil {
+		t.Fatal(err)
+	}
+	configTwo, err := contextBudgetSemanticConfig(two, logical, root, homeTwo)
+	if err != nil || configOne != configTwo {
+		t.Fatal("incidental native auth/home state changed comparison identity")
+	}
+	rawOne, _ := json.Marshal(map[string]any{"mcpServers": one["mcp_servers"]})
+	rawTwo, _ := json.Marshal(map[string]any{"mcpServers": two["mcp_servers"]})
+	mcpOne, err := contextBudgetSemanticMCP(rawOne, logical, root, homeOne)
+	if err != nil {
+		t.Fatal(err)
+	}
+	mcpTwo, err := contextBudgetSemanticMCP(rawTwo, logical, root, homeTwo)
+	if err != nil || mcpOne != mcpTwo {
+		t.Fatal("broker rotation changed MCP comparison identity")
+	}
+	if contextBudgetDigest(rawOne) == contextBudgetDigest(rawTwo) {
+		t.Fatal("exact evidence hashes should still differ")
+	}
+	if _, err := contextBudgetSemanticMCP(rawOne, nil, root, homeOne); err == nil {
+		t.Fatal("unknown enabled broker must be incomparable")
+	}
+	if _, err := contextBudgetSemanticConfig(one, nil, root, homeOne); err == nil {
+		t.Fatal("unknown broker in native config must be incomparable")
+	}
+	changed := map[string]any{"multica-plugins": map[string]any{"connection": "installation", "tools": []any{"inspect:schema2"}}}
+	toolChange, _ := contextBudgetSemanticMCP(rawOne, changed, root, homeOne)
+	if toolChange == mcpOne {
+		t.Fatal("changed enabled tool remained comparable")
+	}
+	two["tool_output_token_limit"] = 4096
+	settingChange, _ := contextBudgetSemanticConfig(two, logical, root, homeTwo)
+	if settingChange == configOne {
+		t.Fatal("relevant native setting remained comparable")
+	}
+	if out := os.Getenv("CONTEXT_BUDGET_IDENTITY_EVIDENCE"); out != "" {
+		if err := contextBudgetWrite(out, map[string]any{"passed": true, "raw_one": contextBudgetDigest(rawOne), "raw_two": contextBudgetDigest(rawTwo), "config_one": configOne, "config_two": configTwo, "mcp_one": mcpOne, "mcp_two": mcpTwo, "changed_tool": toolChange, "changed_setting": settingChange}); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestContextBudgetExistingNativeSignatures(t *testing.T) {
+	source := os.Getenv("CONTEXT_BUDGET_IDENTITY_NATIVE_HOME")
+	if source == "" {
+		t.Skip("existing native evidence projection not requested")
+	}
+	data, err := os.ReadFile(filepath.Join(source, "config.toml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var config map[string]any
+	if err := toml.Unmarshal(data, &config); err != nil {
+		t.Fatal(err)
+	}
