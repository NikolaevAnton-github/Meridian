+	if err := contextBudgetWrite(dest, map[string]any{"config_semantic_sha256": configSHA, "mcp_semantic_sha256": mcpSHA, "config_raw_sha256": contextBudgetDigest(data), "mcp_raw_sha256": contextBudgetDigest(raw)}); err != nil {
+		t.Fatal(err)
+	}
