+	args, err := contextBudgetArgs([]string{"-c", `service_tier="priority"`, "-c", "features.memories=false", "-c", "plugins.bad.enabled=true"})
+	if err != nil || strings.Contains(strings.Join(args, " "), "priority") || !strings.Contains(strings.Join(args, " "), "memories") {
+		t.Fatal("role arg precedence failed")
+	}
+	if _, err := contextBudgetArgs([]string{"--profile=other"}); err == nil {
+		t.Fatal("profile escape accepted")
+	}
+}
+
+// Optional native-smoke fixture export uses the exact production config writer.
+// Only the explicitly supplied Saved directory receives copies; never auth.
+func TestContextBudgetExportNativeProfiles(t *testing.T) {
+	dest := os.Getenv("CONTEXT_BUDGET_SMOKE_ROOT")
+	if dest == "" {
+		t.Skip("native profile export not requested")
+	}
+	root := os.Getenv("MULTICA_CONTEXT_PROJECT_ROOT")
+	if !filepath.IsAbs(dest) || !strings.HasPrefix(filepath.Clean(dest), filepath.Join(root, "Saved")+string(filepath.Separator)) {
+		t.Fatal("export must stay under project Saved")
+	}
+	source := os.Getenv("CONTEXT_BUDGET_SMOKE_CONFIG")
+	data, err := os.ReadFile(source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rolesData, err := os.ReadFile(filepath.Join(root, "Tools", "ContextBudgetRoles.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var roles struct {
+		Roles map[string]contextBudgetProfile `json:"roles"`
+	}
+	if err := json.Unmarshal(rolesData, &roles); err != nil {
+		t.Fatal(err)
+	}
+	for name, profile := range roles.Roles {
+		dir := filepath.Join(dest, name)
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "config.toml"), data, 0o600); err != nil {
+			t.Fatal(err)
