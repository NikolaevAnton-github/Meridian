+package daemon
+
+import (
+	"fmt"
+	"strings"
+)
+
+func buildContextBudgetPrompt(task Task) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "Your assigned issue ID is %s. Read the validated brief `%s` and sibling checkpoint.json if present, then complete the authorized work. The daemon already validated live issue scope/status; the brief replaces a full issue JSON bootstrap.\n", task.IssueID, task.ContextBudgetBrief)
+	fmt.Fprintf(&b, "For compact live state use `Scripts/ContextBudget/context_budget.py state --issue %s` with the existing Python interpreter.\n", task.IssueID)
+	if task.HandoffNote != "" {
+		fmt.Fprintf(&b, "Assignment handoff for this run: %s\n", task.HandoffNote)
+	}
+	fmt.Fprintf(&b, "Scan comments with `multica issue comment list %s --roots-only --summary --compact --output json`; expand only relevant threads with `--thread <id> --tail 30 --compact`.\n", task.IssueID)
+	targets := commentReplyThreads(task)
+	if len(targets) == 0 && task.TriggerCommentID != "" {
+		thread := task.TriggerThreadID
+		if thread == "" {
+			thread = task.TriggerCommentID
+		}
+		fmt.Fprintf(&b, "Read trigger thread %s using that bounded command; deliver this thread's final result with --parent %s.\n", thread, task.TriggerCommentID)
+	}
+	for _, target := range targets {
+		fmt.Fprintf(&b, "Read trigger thread %s using that bounded command; deliver this thread's final result with --parent %s.\n", target.ThreadID, target.ParentID)
+	}
+	if len(task.CoalescedCommentIDs) > 0 {
+		fmt.Fprintf(&b, "Also account for these coalesced comment IDs through bounded thread reads: %s.\n", strings.Join(task.CoalescedCommentIDs, ", "))
+	}
+	if len(targets) == 0 && task.TriggerCommentID == "" {
+		b.WriteString("Deliver the final result as one top-level issue comment.\n")
+	}
+	return b.String()
+}
