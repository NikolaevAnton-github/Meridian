index 0000000..1becb3e
--- /dev/null
+++ b/server/pkg/agent/context_budget_test.go
@@ -0,0 +1,17 @@
+package agent
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestContextBudgetOverridesSurviveNativeMCPFiltering(t *testing.T) {
+	args := buildCodexArgs(ExecOptions{McpConfig: json.RawMessage(`{"mcpServers":{}}`),
+		CustomArgs:             []string{"-c", "mcp_servers.blender.enabled=true"},
+		ContextBudgetOverrides: []string{"-c", "mcp_servers.blender.enabled=false"}}, nil)
+	text := strings.Join(args, " ")
+	if strings.Contains(text, "enabled=true") || !strings.Contains(text, "enabled=false") {
+		t.Fatalf("wrong native role precedence: %s", text)
+	}
+}
