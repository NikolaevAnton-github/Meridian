+package daemon
+
+import (
+	"encoding/json"
+	"github.com/pelletier/go-toml/v2"
+	"os"
+	"path/filepath"
+)
+
+func contextBudgetMerge(base, overlay map[string]any) map[string]any {
+	if base == nil {
+		base = map[string]any{}
+	}
+	for key, value := range overlay {
+		if child, ok := value.(map[string]any); ok {
+			prior, _ := base[key].(map[string]any)
+			base[key] = contextBudgetMerge(prior, child)
+		} else {
+			base[key] = value
+		}
+	}
+	return base
+}
+
+func contextBudgetProjectConfig(root string) (map[string]any, error) {
+	data, err := os.ReadFile(filepath.Join(root, ".codex", "config.toml"))
+	if os.IsNotExist(err) {
+		return map[string]any{}, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var config map[string]any
+	if err := toml.Unmarshal(data, &config); err != nil {
+		return nil, err
+	}
+	return config, nil
+}
+
+func contextBudgetMergeProjectMCP(raw json.RawMessage, root string) (json.RawMessage, error) {
+	var doc map[string]any
+	if err := json.Unmarshal(raw, &doc); err != nil {
+		return nil, err
+	}
+	project, err := contextBudgetProjectConfig(root)
+	if err != nil {
+		return nil, err
+	}
+	base, _ := doc["mcpServers"].(map[string]any)
+	overlay, _ := project["mcp_servers"].(map[string]any)
+	for key, value := range overlay {
+		overlay[key] = normalizeRuntimeMcpEntry("codex", value)
+	}
+	doc["mcpServers"] = contextBudgetMerge(base, overlay)
+	return json.Marshal(doc)
+}
+
+func contextBudgetCheckpointIdentity(value string) string {
+	if value == "" {
+		return "none"
+	}
+	return value
+}
