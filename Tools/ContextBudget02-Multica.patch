new file mode 100644
index 0000000..4d30240
--- /dev/null
+++ b/server/internal/daemon/context_budget.go
@@ -0,0 +1,407 @@
+package daemon
+
+// ContextBudget02 is an opt-in repository policy boundary, not a scheduler.
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log/slog"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/multica-ai/multica/server/internal/daemon/execenv"
+	"github.com/multica-ai/multica/server/pkg/agent"
+	"github.com/pelletier/go-toml/v2"
+)
+
+type contextBudgetProfile struct {
+	MCPAllow             []string `json:"mcp_allow"`
+	PluginAllow          []string `json:"plugin_allow"`
+	SkillAllow           []string `json:"skill_allow"`
+	ThinkingLevel        string   `json:"thinking_level"`
+	ServiceTier          string   `json:"service_tier"`
+	ToolOutputTokenLimit int      `json:"tool_output_token_limit"`
+}
+
+type contextBudgetState struct {
+	Passed                bool                 `json:"passed"`
+	Role                  string               `json:"role"`
+	Profile               contextBudgetProfile `json:"profile"`
+	ProfileSHA            string               `json:"profile_sha256"`
+	BriefSHA              string               `json:"brief_sha256"`
+	CheckpointSHA         string               `json:"checkpoint_sha256"`
+	ScopeSHA              string               `json:"scope_sha256"`
+	Candidate             string               `json:"candidate"`
+	Revision              string               `json:"revision"`
+	Root                  string               `json:"-"`
+	RunDir                string               `json:"-"`
+	Overrides             []string             `json:"-"`
+	ConfigSHA             string               `json:"-"`
+	MCPSHA                string               `json:"-"`
+	ConfigRawSHA          string               `json:"-"`
+	MCPRawSHA             string               `json:"-"`
+	LogicalMCP            map[string]any       `json:"-"`
+	ComparisonUnavailable string               `json:"-"`
+}
+
+func contextBudgetDigest(data []byte) string {
+	sha := sha256.Sum256(data)
+	return hex.EncodeToString(sha[:])
+}
+
+func contextBudgetEnabled(workdir string) bool {
+	root := os.Getenv("MULTICA_CONTEXT_PROJECT_ROOT")
+	if root == "" {
+		return false
+	}
+	a, errA := os.Stat(root)
+	b, errB := os.Stat(workdir)
+	return errA == nil && errB == nil && os.SameFile(a, b)
+}
+
+func contextBudgetWrite(path string, value any) error {
+	data, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(path, append(data, '\n'), 0o600)
+}
+
+// Logs never receive the task token, inherited environment, config values or
+// transcript. Only the task-scoped CLI credential is passed to the gate process.
+func contextBudgetCommand(ctx context.Context, root, script, logPath string, additions map[string]string, args ...string) error {
+	python := os.Getenv("CONTEXT_BUDGET_PYTHON")
+	if !filepath.IsAbs(python) {
+		return fmt.Errorf("context budget: absolute CONTEXT_BUDGET_PYTHON required")
+	}
+	cmd := exec.CommandContext(ctx, python, append([]string{filepath.Join(root, "Scripts", "ContextBudget", script), "--root", root}, args...)...)
+	cmd.Dir = root
+	for _, key := range []string{"PATH", "SystemRoot", "SYSTEMROOT", "WINDIR", "COMSPEC", "TEMP", "TMP", "APPDATA", "LOCALAPPDATA", "USERPROFILE"} {
+		if value := os.Getenv(key); value != "" {
+			cmd.Env = append(cmd.Env, key+"="+value)
+		}
+	}
+	for key, value := range additions {
+		cmd.Env = append(cmd.Env, key+"="+value)
+	}
+	log, err := os.OpenFile(logPath, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	defer log.Close()
+	cmd.Stdout, cmd.Stderr = log, log
+	if err := cmd.Run(); err != nil {
+		return fmt.Errorf("context budget command failed; inspect %s: %w", logPath, err)
+	}
+	return nil
+}
+
+func (d *Daemon) prepareContextBudget(ctx context.Context, task Task, env *execenv.Environment, provider, phase string) (*contextBudgetState, error) {
+	if !contextBudgetEnabled(env.WorkDir) {
+		return nil, nil
+	}
+	if provider != "codex" {
+		return nil, fmt.Errorf("context budget: this repository gate requires Codex")
+	}
+	if task.IssueID == "" {
+		return nil, fmt.Errorf("context budget: a live issue and dispatch brief are required")
+	}
+	if len(task.HandoffNote) > 2048 {
+		return nil, fmt.Errorf("context budget: move oversized handoff scope into the validated brief before dispatch")
+	}
+	token, err := taskScopedAuthToken(task)
+	if err != nil {
+		return nil, err
+	}
+	runDir := filepath.Join(env.WorkDir, "Saved", "ContextBudget02", "runs", task.ID)
+	if err := os.MkdirAll(runDir, 0o700); err != nil {
+		return nil, err
+	}
+	request := filepath.Join(runDir, phase+"-request.json")
+	output := filepath.Join(runDir, phase+"-prepare.json")
+	if err := contextBudgetWrite(request, map[string]any{"issue_id": task.IssueID, "run_id": task.ID,
+		"resume_expected": task.PriorSessionID != "" || task.PriorSessionResumeUnavailable || phase == "cold"}); err != nil {
+		return nil, err
+	}
+	self, err := resolveSelfExecutable()
+	if err != nil {
+		return nil, err
+	}
+	childEnv := map[string]string{"CONTEXT_BUDGET_MULTICA": self, "MULTICA_TOKEN": token,
+		"MULTICA_TASK_ID": task.ID, "MULTICA_AGENT_ID": task.AgentID, "MULTICA_WORKSPACE_ID": task.WorkspaceID,
+		"MULTICA_SERVER_URL": d.cfg.ServerBaseURL, "MULTICA_TASK_CONFIG_ROOT": env.MulticaConfigRoot}
+	gateCtx, cancel := context.WithTimeout(ctx, 45*time.Second)
+	defer cancel()
+	if err := contextBudgetCommand(gateCtx, env.WorkDir, "context_budget.py", filepath.Join(runDir, phase+"-gate.log"), childEnv,
+		"prepare", "--request", request, "--output", output); err != nil {
+		return nil, err
+	}
+	file, err := os.Open(output)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	var state contextBudgetState
+	if err := json.NewDecoder(io.LimitReader(file, 16385)).Decode(&state); err != nil {
+		return nil, err
+	}
+	if !state.Passed || state.Profile.ThinkingLevel != "max" || state.Profile.ServiceTier != "default" {
+		return nil, fmt.Errorf("context budget: invalid gate/profile result")
+	}
+	if task.Agent != nil {
+		if role := task.Agent.CustomEnv["MULTICA_CONTEXT_ROLE"]; role != "" && role != state.Role {
+			return nil, fmt.Errorf("context budget: agent role differs from validated brief")
+		}
+	}
+	state.Root, state.RunDir = env.WorkDir, runDir
+	state.LogicalMCP = contextBudgetLogicalServers(task)
+	return &state, nil
+}
+
+func contextBudgetMatches(name string, patterns []string) bool {
+	for _, pattern := range patterns {
+		if ok, _ := filepath.Match(pattern, name); ok {
+			return true
+		}
+	}
+	return false
+}
+
+func contextBudgetMCP(raw json.RawMessage, profile contextBudgetProfile) (json.RawMessage, error) {
+	var document map[string]any
+	if len(raw) > 0 && string(raw) != "null" {
+		if err := json.Unmarshal(raw, &document); err != nil {
+			return nil, err
+		}
+	}
+	servers, _ := document["mcpServers"].(map[string]any)
+	filtered := map[string]any{}
+	for name, value := range servers {
+		entry, ok := value.(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("invalid context MCP entry")
+		}
+		if !contextBudgetMatches(name, profile.MCPAllow) {
+			entry["enabled"] = false
+		}
+		filtered[name] = entry
+	}
+	return json.Marshal(map[string]any{"mcpServers": filtered})
+}
+
+// The task-local copy is rewritten semantically. Global config/auth are never
+// opened for writing. Native per-plugin/per-skill keys remain authoritative.
+func applyContextBudgetNative(state *contextBudgetState, codexHome string) error {
+	if state == nil {
+		return nil
+	}
+	configPath := filepath.Join(codexHome, "config.toml")
+	data, err := os.ReadFile(configPath)
+	if err != nil {
+		return err
+	}
+	var config map[string]any
+	if err := toml.Unmarshal(data, &config); err != nil {
+		return err
+	}
+	// Materialize trusted project overlays in the private home; owner bytes remain untouched.
+	project, err := contextBudgetProjectConfig(state.Root)
+	if err != nil {
+		return err
+	}
+	config = contextBudgetMerge(config, project)
+	config["model_reasoning_effort"], config["service_tier"] = "max", "default"
+	if state.Profile.ToolOutputTokenLimit <= 0 || state.Profile.ToolOutputTokenLimit > 8192 {
+		return fmt.Errorf("context budget: invalid native tool output budget")
+	}
+	config["tool_output_token_limit"] = state.Profile.ToolOutputTokenLimit
+	// Keep the generated config useful for inspection before the adapter rewrites
+	// its final merged MCP block at launch.
+	servers, _ := config["mcp_servers"].(map[string]any)
+	for name := range servers {
+		if !contextBudgetMatches(name, state.Profile.MCPAllow) {
+			entry, ok := servers[name].(map[string]any)
+			if !ok {
+				return fmt.Errorf("invalid native MCP entry")
+			}
+			entry["enabled"] = false
+		}
+	}
+	features, _ := config["features"].(map[string]any)
+	if features == nil {
+		features = map[string]any{}
+	}
+	features["apps"] = false
+	config["features"] = features
+	state.Overrides = []string{"-c", `model_reasoning_effort="max"`, "-c", `service_tier="default"`, "-c", "features.apps=false"}
+	state.Overrides = append(state.Overrides, "-c", fmt.Sprintf("tool_output_token_limit=%d", state.Profile.ToolOutputTokenLimit))
+	var deniedServers []string
+	for name := range servers {
+		if !contextBudgetMatches(name, state.Profile.MCPAllow) {
+			deniedServers = append(deniedServers, name)
+		}
+	}
+	sort.Strings(deniedServers)
+	for _, name := range deniedServers {
+		if strings.ContainsAny(name, ".\"' ") {
+			return fmt.Errorf("context budget: unsupported native MCP key")
+		}
+		state.Overrides = append(state.Overrides, "-c", "mcp_servers."+name+".enabled=false")
+	}
+	plugins, _ := config["plugins"].(map[string]any)
+	var disabledPlugins []string
+	for name, item := range plugins {
+		if !contextBudgetMatches(name, state.Profile.PluginAllow) {
+			entry, ok := item.(map[string]any)
+			if !ok {
+				return fmt.Errorf("context budget: malformed plugin entry")
+			}
+			entry["enabled"] = false
+			disabledPlugins = append(disabledPlugins, name)
+		}
+	}
+	sort.Strings(disabledPlugins)
+	for _, name := range disabledPlugins {
+		if strings.ContainsAny(name, ".\"' ") {
+			return fmt.Errorf("context budget: unsupported native plugin key")
+		}
+		state.Overrides = append(state.Overrides, "-c", "plugins."+name+".enabled=false")
+	}
+	skills, _ := config["skills"].(map[string]any)
+	if skills == nil {
+		skills = map[string]any{}
+	}
+	entries, _ := skills["config"].([]any)
+	var disabledSkills []string
+	for _, base := range []string{filepath.Join(codexHome, "skills"), filepath.Join(codexHome, "skills", ".system"), filepath.Join(state.Root, ".agents", "skills")} {
+		dirs, readErr := os.ReadDir(base)
+		if os.IsNotExist(readErr) {
+			continue
+		}
+		if readErr != nil {
+			return readErr
+		}
+		for _, dir := range dirs {
+			skill := filepath.Join(base, dir.Name())
+			if _, err := os.Stat(filepath.Join(skill, "SKILL.md")); err != nil {
+				continue
+			}
+			if contextBudgetMatches(dir.Name(), state.Profile.SkillAllow) {
+				continue
+			}
+			entries = append(entries, map[string]any{"path": skill, "enabled": false})
+			disabledSkills = append(disabledSkills, skill)
+		}
+	}
+	skills["config"] = entries
+	config["skills"] = skills
+	data, err = toml.Marshal(config)
+	if err != nil {
+		return err
+	}
+	if err := os.WriteFile(configPath, data, 0o600); err != nil {
+		return err
+	}
+	sha := sha256.Sum256(data)
+	state.ConfigRawSHA = hex.EncodeToString(sha[:])
+	state.ConfigSHA, err = contextBudgetSemanticConfig(config, state.LogicalMCP, state.Root, codexHome)
+	if err != nil {
+		state.ComparisonUnavailable = err.Error()
+	}
+	return contextBudgetWrite(filepath.Join(state.RunDir, "native-config.json"), map[string]any{
+		"role": state.Role, "config_sha256": hex.EncodeToString(sha[:]), "model_reasoning_effort": "max", "service_tier": "default",
+		"disabled_plugins": disabledPlugins, "disabled_skills": disabledSkills, "mcp_allow": state.Profile.MCPAllow,
+		"tool_output_token_limit":  state.Profile.ToolOutputTokenLimit,
+		"disabled_mcp_servers":     deniedServers,
+		"comparison_config_sha256": state.ConfigSHA,
+		"comparison_unavailable":   state.ComparisonUnavailable,
+		"limits":                   "Host-controlled/system capabilities outside native task config are not universally filtered; native history output budget does not save full artifacts."})
+}
+
+// Protected settings are reapplied at the end of the native override list.
+// Named profiles can reset unrelated capability sections, so fail closed here.
+func contextBudgetArgs(args []string) ([]string, error) {
+	var out []string
+	for i := 0; i < len(args); i++ {
+		arg := args[i]
+		if (arg == "--enable" || arg == "--disable") && i+1 < len(args) && args[i+1] == "apps" {
+			i++
+			continue
+		}
+		if arg == "--enable=apps" || arg == "--disable=apps" {
+			continue
+		}
+		if arg == "-p" || arg == "--profile" || strings.HasPrefix(arg, "--profile=") {
+			return nil, fmt.Errorf("context budget: native named profile conflicts with task role")
+		}
+		flag, value, inline := strings.Cut(arg, "=")
+		if flag == "-c" || flag == "--config" {
+			if !inline && i+1 < len(args) {
+				value = args[i+1]
+			}
+			key := strings.TrimSpace(strings.SplitN(value, "=", 2)[0])
+			if key == "model_reasoning_effort" || key == "service_tier" || key == "tool_output_token_limit" || key == "features.apps" || strings.HasPrefix(key, "plugins") || strings.HasPrefix(key, "skills") {
+				if !inline {
+					i++
+				}
+				continue
+			}
+		}
+		out = append(out, arg)
+	}
+	return out, nil
+}
+
+// This shared boundary is used by both initial injection and cold reinjection.
+// A failed gate must never call the supplied mutating operation.
+func contextBudgetBeforeInjection(prepare func() (*contextBudgetState, error), inject func(*contextBudgetState) (string, error)) (*contextBudgetState, string, error) {
+	state, err := prepare()
+	if err != nil {
+		return nil, "", err
+	}
+	brief, err := inject(state)
+	return state, brief, err
+}
+
+func (d *Daemon) executeContextBudgetAndDrain(ctx context.Context, state *contextBudgetState, phase string, backend agent.Backend, prompt string, opts agent.ExecOptions, taskLog *slog.Logger, taskID, codexHome string, msgSeq *atomic.Int32) (agent.Result, int32, error) {
+	started := time.Now().UTC().Format(time.RFC3339Nano)
+	result, count, err := d.executeAndDrain(ctx, backend, prompt, opts, taskLog, taskID, codexHome, msgSeq)
+	ended := time.Now().UTC().Format(time.RFC3339Nano)
+	if state == nil {
+		return result, count, err
+	}
+	binding := filepath.Join(state.RunDir, phase+"-binding.json")
+	workloadSHA := sha256.Sum256([]byte(prompt))
+	launch, _ := json.Marshal(append(append([]string{}, opts.ExtraArgs...), opts.CustomArgs...))
+	launch = append(launch, []byte(strings.Join(opts.ContextBudgetOverrides, "\x00"))...)
+	launchSHA := sha256.Sum256(launch)
+	writeErr := contextBudgetWrite(binding, map[string]any{"run_id": taskID, "candidate": state.Candidate, "revision": state.Revision,
+		"profile_sha256": state.ProfileSHA, "brief_sha256": state.BriefSHA, "workload": hex.EncodeToString(workloadSHA[:]),
+		"checkpoint_sha256":       contextBudgetCheckpointIdentity(state.CheckpointSHA),
+		"effective_config_sha256": state.ConfigSHA, "mcp_sha256": state.MCPSHA, "launch_args_sha256": hex.EncodeToString(launchSHA[:]),
+		"config_raw_sha256": state.ConfigRawSHA, "mcp_raw_sha256": state.MCPRawSHA, "comparison_unavailable": state.ComparisonUnavailable,
+		"completed": result.Status == "completed",
+		"ended_at":  ended,
+		"model":     opts.Model, "service_tier": opts.ServiceTier, "prior_session_id": opts.ResumeSessionID,
+		"resume_expected": opts.ResumeExpected, "role": state.Role})
+	if writeErr == nil {
+		usageCtx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+		writeErr = contextBudgetCommand(usageCtx, state.Root, "usage.py", filepath.Join(state.RunDir, phase+"-usage.log"), nil,
+			"collect", "--codex-home", codexHome, "--thread-id", result.SessionID, "--since", started,
+			"--binding", binding, "--output", filepath.Join(state.RunDir, phase+"-usage.json"))
+		cancel()
+	}
+	if writeErr != nil {
+		taskLog.Warn("context budget native usage unavailable", "error", writeErr)
+		_ = contextBudgetWrite(filepath.Join(state.RunDir, phase+"-usage.json"), map[string]any{"coverage": "collector_failed", "run_id": taskID})
+	}
+	return result, count, err
+}
diff --git a/server/internal/daemon/context_budget_identity.go b/server/internal/daemon/context_budget_identity.go
new file mode 100644
index 0000000..12c75b3
--- /dev/null
+++ b/server/internal/daemon/context_budget_identity.go
@@ -0,0 +1,193 @@
+package daemon
+
+// Exact evidence hashes are separate from semantic comparison fingerprints.
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+func contextBudgetSecretKey(key string) bool {
+	key = strings.NewReplacer("_", "", "-", "", ".", "").Replace(strings.ToUpper(key))
+	for _, suffix := range []string{"TOKEN", "PASSWORD", "SECRET", "APIKEY", "AUTHORIZATION", "COOKIE", "ACCESSKEY"} {
+		if strings.HasSuffix(key, suffix) {
+			return true
+		}
+	}
+	return key == "AUTH" || key == "SIGNATURE"
+}
+
+func contextBudgetNormalizePath(value, root, home string) string {
+	value = strings.ReplaceAll(value, "\\", "/")
+	for _, pair := range [][2]string{{home, "<TASK_CODEX_HOME>"}, {filepath.Dir(home), "<TASK_ROOT>"}, {root, "<PROJECT_ROOT>"}} {
+		prefix := strings.TrimRight(strings.ReplaceAll(pair[0], "\\", "/"), "/")
+		if prefix != "" && (strings.EqualFold(value, prefix) || strings.HasPrefix(strings.ToLower(value), strings.ToLower(prefix)+"/")) {
+			return pair[1] + value[len(prefix):]
+		}
+	}
+	return value
+}
+
+func contextBudgetSemanticValue(value any, key, root, home string) any {
+	switch typed := value.(type) {
+	case map[string]any:
+		out := map[string]any{}
+		for name, child := range typed {
+			out[contextBudgetNormalizePath(name, root, home)] = contextBudgetSemanticValue(child, name, root, home)
+		}
+		return out
+	case []any:
+		out := make([]any, len(typed))
+		for i, child := range typed {
+			out[i] = contextBudgetSemanticValue(child, key, root, home)
+		}
+		if key == "args" {
+			for i, child := range typed {
+				arg, ok := child.(string)
+				if !ok || !strings.HasPrefix(arg, "-") {
+					continue
+				}
+				flag, _, inline := strings.Cut(arg, "=")
+				if !contextBudgetSecretKey(strings.TrimLeft(flag, "-")) {
+					continue
+				}
+				if inline {
+					out[i] = flag + "=<CREDENTIAL_VALUE>"
+				} else if i+1 < len(out) {
+					out[i+1] = "<CREDENTIAL_VALUE>"
+				}
+			}
+		}
+		return out
+	case string:
+		if contextBudgetSecretKey(key) {
+			return "<CREDENTIAL_VALUE>"
+		}
+		if strings.EqualFold(key, "MULTICA_TASK_ID") {
+			return "<TASK_ID>"
+		}
+		if strings.EqualFold(key, "MULTICA_DAEMON_PORT") {
+			return "<TASK_DAEMON_PORT>"
+		}
+		if parsed, err := url.Parse(typed); err == nil && (parsed.Scheme == "http" || parsed.Scheme == "https") {
+			if parsed.User != nil {
+				parsed.User = url.User("<CREDENTIAL>")
+			}
+			query := parsed.Query()
+			for name := range query {
+				if contextBudgetSecretKey(name) || strings.EqualFold(name, "key") {
+					query.Set(name, "<CREDENTIAL_VALUE>")
+				}
+			}
+			parsed.RawQuery = query.Encode()
+			return parsed.String()
+		}
+		// JSON-valued environment settings contain structural paths, not substrings
+		// to blindly replace inside arbitrary instructions or user configuration.
+		var nested any
+		if (strings.HasPrefix(typed, "{") || strings.HasPrefix(typed, "[")) && json.Unmarshal([]byte(typed), &nested) == nil {
+			return contextBudgetSemanticValue(nested, key, root, home)
+		}
+		if filepath.IsAbs(typed) || (len(typed) > 2 && typed[1] == ':') {
+			return contextBudgetNormalizePath(typed, root, home)
+		}
+		return typed
+	default:
+		return value
+	}
+}
+
+func contextBudgetSemanticServers(servers map[string]any, logical map[string]any, root, home string) (map[string]any, error) {
+	out := map[string]any{}
+	for name, value := range servers {
+		entry, ok := value.(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("incomparable MCP entry: %s", name)
+		}
+		if entry["enabled"] == false || entry["disabled"] == true {
+			continue
+		}
+		projection := map[string]any{}
+		for key, item := range entry {
+			projection[key] = item
+		}
+		if strings.HasPrefix(name, "plugin-") || name == "multica-plugins" {
+			identity, ok := logical[name]
+			if !ok {
+				return nil, fmt.Errorf("incomparable enabled broker without logical identity: %s", name)
+			}
+			delete(projection, "url")
+			projection["logical_identity"] = identity
+		}
+		out[name] = contextBudgetSemanticValue(projection, name, root, home)
+	}
+	return out, nil
+}
+
+func contextBudgetSemanticMCP(raw json.RawMessage, logical map[string]any, root, home string) (string, error) {
+	var doc map[string]any
+	if err := json.Unmarshal(raw, &doc); err != nil {
+		return "", err
+	}
+	servers, _ := doc["mcpServers"].(map[string]any)
+	projected, err := contextBudgetSemanticServers(servers, logical, root, home)
+	if err != nil {
+		return "", err
+	}
+	data, err := json.Marshal(projected)
+	return contextBudgetDigest(data), err
+}
+
+func contextBudgetSemanticConfig(config map[string]any, logical map[string]any, root, home string) (string, error) {
+	projected := contextBudgetSemanticValue(config, "", root, home).(map[string]any)
+	servers, _ := config["mcp_servers"].(map[string]any)
+	semantic, err := contextBudgetSemanticServers(servers, logical, root, home)
+	if err != nil {
+		return "", err
+	}
+	projected["mcp_servers"] = semantic
+	data, err := json.Marshal(projected)
+	return contextBudgetDigest(data), err
+}
+
+func contextBudgetLogicalServers(task Task) map[string]any {
+	out := map[string]any{}
+	for _, connection := range task.RemoteMCPConnections {
+		if connection.ContributionID == "" || len(connection.ApprovedTools) == 0 {
+			continue
+		}
+		tools := make([]string, 0, len(connection.ApprovedTools))
+		valid := true
+		for _, tool := range connection.ApprovedTools {
+			if tool.Name == "" || tool.SchemaDigest == "" {
+				valid = false
+				break
+			}
+			tools = append(tools, tool.Name+":"+tool.SchemaDigest+":"+contextBudgetDigest([]byte(tool.Description)))
+		}
+		if !valid {
+			continue
+		}
+		sort.Strings(tools)
+		var public any
+		if len(connection.PublicConfig) > 0 && json.Unmarshal(connection.PublicConfig, &public) != nil {
+			continue
+		}
+		out[remoteMCPServerName(connection)] = map[string]any{"installation": connection.InstallationID, "connection": connection.ContributionID,
+			"key": connection.ContributionKey, "config_id": connection.ConfigID, "config_revision": connection.ConfigRevision,
+			"endpoint": connection.Endpoint, "transport": connection.Transport, "auth_header_name": connection.CredentialHeader,
+			"tools": tools, "schema_digest": connection.ToolSchemaDigest, "public_config": public}
+	}
+	if len(task.PluginHookTools) > 0 {
+		hooks := make([]string, 0, len(task.PluginHookTools))
+		for _, tool := range task.PluginHookTools {
+			hooks = append(hooks, tool.InstallationID+":"+tool.HookKey+":"+tool.Name+":"+contextBudgetDigest(tool.InputSchema)+":"+contextBudgetDigest([]byte(tool.Description)))
+		}
+		sort.Strings(hooks)
+		out["multica-plugins"] = map[string]any{"hooks": hooks}
+	}
+	return out
+}
