+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/multica-ai/multica/server/internal/daemon/execenv"
+	"github.com/pelletier/go-toml/v2"
+)
+
+func TestContextBudgetInjectionAndColdRetryFailClosed(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "AGENTS.md")
+	original := []byte("Owner bytes\r\n")
+	if err := os.WriteFile(path, original, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	for _, phase := range []string{"initial", "cold"} {
+		t.Run(phase, func(t *testing.T) {
+			_, _, err := contextBudgetBeforeInjection(
+				func() (*contextBudgetState, error) { return nil, errors.New("stale checkpoint") },
+				func(*contextBudgetState) (string, error) {
+					return execenv.InjectRuntimeConfig(root, "codex", execenv.TaskContextForEnv{})
+				})
+			if err == nil {
+				t.Fatal("failed gate allowed injection")
+			}
+			got, _ := os.ReadFile(path)
+			if string(got) != string(original) {
+				t.Fatal("guard failure mutated owner instructions")
+			}
+		})
+	}
+	_, brief, err := contextBudgetBeforeInjection(func() (*contextBudgetState, error) { return &contextBudgetState{Passed: true}, nil },
+		func(*contextBudgetState) (string, error) {
+			return execenv.InjectRuntimeConfig(root, "codex", execenv.TaskContextForEnv{})
+		})
+	if err != nil || brief == "" {
+		t.Fatalf("valid gate did not inject: %v", err)
+	}
+	if err := execenv.CleanupRuntimeConfig(root, "codex"); err != nil {
+		t.Fatal(err)
+	}
+	got, _ := os.ReadFile(path)
+	if string(got) != string(original) {
+		t.Fatal("cleanup did not preserve exact owner bytes")
+	}
+}
+
+func TestContextBudgetProjectScopeAndMissingPolicy(t *testing.T) {
+	root, other := t.TempDir(), t.TempDir()
+	t.Setenv("MULTICA_CONTEXT_PROJECT_ROOT", root)
+	if !contextBudgetEnabled(root) || contextBudgetEnabled(other) {
+		t.Fatal("project scope mismatch")
+	}
+	d := &Daemon{}
+	if state, err := d.prepareContextBudget(context.Background(), Task{}, &execenv.Environment{WorkDir: other}, "codex", "initial"); state != nil || err != nil {
+		t.Fatal("unrelated project was gated")
+	}
+	if _, err := d.prepareContextBudget(context.Background(), Task{}, &execenv.Environment{WorkDir: root}, "codex", "cold"); err == nil {
+		t.Fatal("missing live issue allowed")
+	}
+}
+
+func TestContextBudgetMCPAndNativeProfiles(t *testing.T) {
+	root, home := t.TempDir(), t.TempDir()
+	config := `model = "gpt-6-astra"
+model_reasoning_effort = "medium"
+service_tier = "priority"
+[features]
+memories = false
+[mcp_servers.rider]
+url = "http://localhost/rider"
+[mcp_servers.blender]
+command = "blender"
+[plugins."documents@test"]
+enabled = true
+`
+	if err := os.WriteFile(filepath.Join(home, "config.toml"), []byte(config), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	projectConfig := []byte("[mcp_servers.blender.env]\nOVERLAY = 'retained'\n[mcp_servers.unreal_epic]\nurl = 'http://localhost/unreal'\nenabled = true\n")
+	if err := os.MkdirAll(filepath.Join(root, ".codex"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, ".codex", "config.toml"), projectConfig, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Join(home, "skills", "unrelated"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(home, "skills", "unrelated", "SKILL.md"), []byte("skill"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	state := &contextBudgetState{Root: root, RunDir: root, Role: "code", Profile: contextBudgetProfile{MCPAllow: []string{"rider"}, SkillAllow: []string{"multica-platform"}, ThinkingLevel: "max", ServiceTier: "default", ToolOutputTokenLimit: 2048}}
+	if err := applyContextBudgetNative(state, home); err != nil {
+		t.Fatal(err)
+	}
+	data, _ := os.ReadFile(filepath.Join(home, "config.toml"))
+	var actual map[string]any
+	if err := toml.Unmarshal(data, &actual); err != nil {
+		t.Fatal(err)
+	}
+	if actual["model_reasoning_effort"] != "max" || actual["service_tier"] != "default" {
+		t.Fatal("native settings not applied")
+	}
+	servers := actual["mcp_servers"].(map[string]any)
+	if servers["rider"] == nil || servers["blender"].(map[string]any)["enabled"] != false || servers["unreal_epic"].(map[string]any)["enabled"] != false {
+		t.Fatal("native role lost required MCP or retained unrelated server")
+	}
+	blender := servers["blender"].(map[string]any)
+	if blender["command"] != "blender" || blender["env"].(map[string]any)["OVERLAY"] != "retained" {
+		t.Fatal("project env overlay lost home transport")
+	}
+	ownerAfter, _ := os.ReadFile(filepath.Join(root, ".codex", "config.toml"))
+	if string(ownerAfter) != string(projectConfig) {
+		t.Fatal("project owner config changed")
